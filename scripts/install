#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# RETRIEVE ARGUMENTS FROM THE MANIFEST
#=================================================

# server_name is asked as an install question (type = domain) but is NOT the
# install domain in general: it is the Matrix server_name. It may be equal
# to $domain (root install) or to a different, base domain managed by this
# YunoHost instance (delegation via .well-known).

# Normalise booleans to TOML literal strings ("true" / "false").
allow_registration=$(normalise_bool "$registration")
allow_federation=$(normalise_bool "$federation")

# Generate a registration token if registration is enabled, else leave empty.
if [ "$allow_registration" = "true" ]; then
    registration_token=$(ynh_string_random --length=27)
else
    registration_token=""
fi

# Persist settings used by templates and other scripts.
ynh_app_setting_set --key=server_name --value="$server_name"
ynh_app_setting_set --key=allow_registration --value="$allow_registration"
ynh_app_setting_set --key=allow_federation --value="$allow_federation"
ynh_app_setting_set --key=registration_token --value="$registration_token"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:root" "$install_dir"
chmod +x "$install_dir/continuwuity"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template="continuwuity.toml" --destination="$install_dir/continuwuity.toml"

chmod 400 "$install_dir/continuwuity.toml"
chown "$app:$app" "$install_dir/continuwuity.toml"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# .well-known delegation, on the server_name domain (only if managed by YunoHost).
if yunohost --output-as plain domain list | grep -q "^$server_name$"; then
    ynh_config_add --template="server_name.conf" \
        --destination="/etc/nginx/conf.d/${server_name}.d/${app}_server_name.conf"
fi

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" \
    --description="Continuwuity Matrix homeserver" \
    --log="systemd"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="systemd"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"

if [ "$allow_registration" = "true" ]; then
    # On a fresh database, continuwuity IGNORES the registration_token from
    # the config file and prints a fresh ephemeral "first user" token in
    # the journald startup banner on every start. That ephemeral token is
    # the only one that works to register the very first user. Once the
    # first user exists, the config-file token becomes active again.
    # See upstream banner: "The registration token you set in your
    # configuration will not function until you create an account using
    # the token above."
    ephemeral_token=$(journalctl -u "$app.service" -n 50 --no-pager \
        | grep -oP "registration token \K[^ ]+(?= \.)" | tail -1)

    ynh_print_info "Registration token (for the FIRST user — required to bootstrap the admin):"
    if [ -n "$ephemeral_token" ]; then
        ynh_print_info "  $ephemeral_token"
        ynh_print_info "  This token is rotated on every service restart while the database has no users."
        ynh_print_info "  If the service has restarted since, get the latest one with:"
        ynh_print_info "    sudo journalctl -u $app.service -n 30 --no-pager | grep 'registration token'"
    else
        ynh_print_info "  $registration_token"
        ynh_print_info "  (Could not read the ephemeral token from journald — this is the config-file token,"
        ynh_print_info "   which works once at least one user exists. If no user exists yet, check the"
        ynh_print_info "   startup banner: sudo journalctl -u $app.service -n 30 --no-pager | grep 'registration token')"
    fi
    ynh_print_info "Then in your Matrix client (e.g. Element), set the homeserver to https://$domain"
    ynh_print_info "(or just '$server_name' — .well-known delegation will resolve it),"
    ynh_print_info "pick a username/password, and paste the token when prompted. The first user becomes the admin."
else
    ynh_print_info "Registration is disabled. Use the admin room to create users. See upstream docs: https://continuwuity.org/"
fi
